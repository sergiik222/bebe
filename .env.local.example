# Backend API URL (Go service for booking, contact, admin, gallery)
# Local dev:  http://localhost:8080
# Production: https://your-backend-domain.example
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Bunny CDN (storage account for portfolio + gallery media)
# Get these from https://dash.bunny.net/
NEXT_PUBLIC_BUNNY_STORAGE_ZONE_NAME=your-storage-zone-name
BUNNY_STORAGE_PASSWORD=your-bunny-storage-zone-password
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=your-pullzone.b-cdn.net
BUNNY_STORAGE_REGION=de

# Optional: For private file sharing (future feature)
# BUNNY_TOKEN_KEY=your-bunny-token-authentication-key

# Environment
NODE_ENV=development
